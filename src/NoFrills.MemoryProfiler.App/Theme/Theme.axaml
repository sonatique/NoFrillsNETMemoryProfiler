<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ResourceDictionary.MergedDictionaries>
    <ResourceInclude Source="avares://NoFrills.MemoryProfiler.App/Theme/Colors.axaml" />
  </ResourceDictionary.MergedDictionaries>

  <!--
    The palette says one vivid accent for what is actionable or alive, everything else neutral.
    The Fluent theme picks its own accent from the system, so it is pointed at ours here; without
    this the selected row and the focus rings would still be the system blue.
  -->
  <Color x:Key="SystemAccentColor">#FF4FAE7A</Color>
  <Color x:Key="SystemAccentColorLight1">#FF63C48F</Color>
  <Color x:Key="SystemAccentColorLight2">#FF7FD3A4</Color>
  <Color x:Key="SystemAccentColorLight3">#FF9FE0BC</Color>
  <Color x:Key="SystemAccentColorDark1">#FF3D8F63</Color>
  <Color x:Key="SystemAccentColorDark2">#FF2F7150</Color>
  <Color x:Key="SystemAccentColorDark3">#FF23543C</Color>

  <!--
    Selection uses the accent, and text on it has to stay readable: the accent is light enough that
    the dark background colour is the legible choice on top of it.
  -->
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource BackgroundColor}" />

  <!-- The window paints these itself rather than inheriting the theme's own greys. -->
  <SolidColorBrush x:Key="WindowBackgroundBrush" Color="{StaticResource BackgroundColor}" />

</ResourceDictionary>
